<Window x:Class="QuickShot.Windows.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickShot 设置" SizeToContent="Height" Icon="/Assets/QuickShot.ico"
 ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" Background="#FAFAFC">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
    <TextBlock Text="快捷键" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
    <TextBlock Text="截图保存"/><TextBox x:Name="SaveHotkeyBox"/>
    <TextBlock Text="截图复制"/><TextBox x:Name="CopyHotkeyBox"/>
    <TextBlock Text="识别文字"/><TextBox x:Name="OcrHotkeyBox"/>
    <TextBlock Text="截图贴图"/><TextBox x:Name="PinHotkeyBox"/>
    <TextBlock Text="关闭当前贴图（仅贴图激活时）" TextWrapping="Wrap"/><TextBox x:Name="ClosePinHotkeyBox"/>
    <TextBlock Text="截图快捷键需要 Alt / Ctrl / Shift / Win；关闭贴图默认 Delete。快捷键不能重复。" TextWrapping="Wrap" Foreground="#697080"/>
    <TextBlock Text="截图保存目录" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
    <TextBox x:Name="SaveDirectoryBox" TextWrapping="Wrap"/>
    <WrapPanel><Button Content="浏览目录…" Click="Browse_Click"/><Button Content="打开此目录" Click="OpenDirectory_Click"/></WrapPanel>
    <TextBlock Text="点击“保存设置”后立即生效。另存为时仍可为单张截图选择其他位置。" TextWrapping="Wrap" Foreground="#697080"/>
    <TextBlock Text="文字识别" FontSize="18" FontWeight="SemiBold" Margin="0,16,0,8"/>
    <TextBlock Text="本地中文 V5：中文 / 英文 / 数字 / 常用标点，兼顾日文。无需另装 Windows 语言包。" TextWrapping="Wrap"/>
    <TextBlock Text="输入处理" Margin="0,8,0,2"/>
    <ComboBox x:Name="OcrModeBox" SelectedIndex="0">
     <ComboBoxItem Content="原始截图（默认）"/>
     <ComboBoxItem Content="小字：放大 2 倍"/>
     <ComboBoxItem Content="黑底白字：反色"/>
     <ComboBoxItem Content="黑底小字：反色并放大"/>
    </ComboBox>
    <CheckBox x:Name="RotateBox" Margin="0,10,0,4"><TextBlock Text="检测倾斜文字（普通屏幕文字建议关闭）" TextWrapping="Wrap"/></CheckBox>
    <TextBlock Text="始终保留原始像素；不强制二值化、不删除 Unicode 字符。模型随发布目录携带，第一次识别只加载本地模型，不下载。" TextWrapping="Wrap" Foreground="#697080"/>
    <CheckBox x:Name="NotificationBox" Margin="0,14,0,4"><TextBlock Text="操作完成后显示系统提示" TextWrapping="Wrap"/></CheckBox>
   </StackPanel>
  </ScrollViewer>
  <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
   <Button Content="取消" IsCancel="True" Click="Cancel_Click"/>
   <Button Content="保存设置" Click="Save_Click" Background="#5B6EF5" Foreground="White"/>
  </WrapPanel>
 </Grid>
</Window>
