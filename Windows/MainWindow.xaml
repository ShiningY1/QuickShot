<Window x:Class="QuickShot.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="QuickShot" Icon="/Assets/QuickShot.ico" SizeToContent="Height"
 ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
 Background="White" Closing="OnClosing" SourceInitialized="OnSourceInitialized">
 <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="14">
   <Grid Margin="4,0,4,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="QuickShot" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button x:Name="MenuButton" Grid.Column="1" Click="Menu_Click" Content="菜单"/>
   </Grid>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Button Click="Save_Click" Content="截图保存" ToolTip="框选区域并另存为 PNG"/>
    <Button Grid.Column="1" Click="Copy_Click" Content="截图复制" ToolTip="框选区域并复制图片"/>
    <Button Grid.Row="1" Click="Pin_Click" Content="截图贴图"/>
    <Button Grid.Row="1" Grid.Column="1" Click="Ocr_Click" Content="识别文字"/>
   </Grid>
   <WrapPanel Margin="0,6,0,0">
    <Button Click="OpenDirectory_Click" Content="打开截图目录"/>
    <Button Click="Settings_Click" Content="设置"/>
   </WrapPanel>
   <TextBlock x:Name="StatusText" Margin="4,8,4,2" Text="框选时按 Esc 取消；关闭主窗口后驻留托盘。" TextWrapping="Wrap" Foreground="#697080"/>
  </StackPanel>
 </ScrollViewer>
</Window>
